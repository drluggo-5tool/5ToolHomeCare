@page
@model FiveToolHomeCare.Pages.IndexModel
@{
    Layout = null;
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>5 Tool Home Care | Sunset Beach, NC</title>

    <meta
        name="description"
        content="5 Tool Home Care provides scheduled air filter maintenance, property care, and developing pool care services in Sunset Beach, North Carolina."
    >

    <!-- Bootstrap CSS -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
        crossorigin="anonymous"
    >

    <style>
        :root {
            --brand-navy: #17365d;
            --brand-blue: #2676ad;
            --brand-light-blue: #eaf4fa;
            --brand-green: #6b8e52;
            --brand-dark: #17202a;
            --brand-gray: #667085;
            --brand-light: #f6f8fa;
            --brand-white: #ffffff;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            color: var(--brand-dark);
            font-family:
                Inter,
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;
        }

        section {
            scroll-margin-top: 90px;
        }

        /* Navigation */

        .navbar {
            background: rgba(255, 255, 255, 0.97);
            box-shadow: 0 2px 18px rgba(15, 23, 42, 0.08);
            padding: 10px 0;
        }

        .navbar-brand img {
            display: block;
            width: 280px;
            max-width: 100%;
            height: auto;
        }

        .navbar .nav-link {
            color: var(--brand-dark);
            font-weight: 600;
            margin-left: 0.75rem;
        }

        .navbar .nav-link:hover,
        .navbar .nav-link:focus {
            color: var(--brand-blue);
        }

        /* Buttons */

        .btn-brand {
            color: var(--brand-white);
            background-color: var(--brand-blue);
            border-color: var(--brand-blue);
            padding: 0.85rem 1.5rem;
            font-weight: 700;
            border-radius: 0.55rem;
        }

        .btn-brand:hover,
        .btn-brand:focus {
            color: var(--brand-white);
            background-color: var(--brand-navy);
            border-color: var(--brand-navy);
        }

        .btn-outline-light-custom {
            color: var(--brand-white);
            background: transparent;
            border: 2px solid rgba(255, 255, 255, 0.85);
            padding: 0.78rem 1.5rem;
            font-weight: 700;
            border-radius: 0.55rem;
        }

        .btn-outline-light-custom:hover {
            color: var(--brand-navy);
            background: var(--brand-white);
            border-color: var(--brand-white);
        }

        /* Hero */

        .hero {
            position: relative;
            min-height: 760px;
            display: flex;
            align-items: center;
            padding-top: 110px;
            color: var(--brand-white);
            background:
                linear-gradient(
                    90deg,
                    rgba(11, 31, 52, 0.92) 0%,
                    rgba(20, 52, 83, 0.76) 48%,
                    rgba(20, 52, 83, 0.38) 100%
                ),
                url("/images/hero.jpg") center center / cover no-repeat;
        }

        .hero-content {
            max-width: 760px;
            padding-top: 3rem;
            padding-bottom: 6rem;
        }

        .hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            padding: 0.45rem 0.85rem;
            margin-bottom: 1.5rem;
            color: var(--brand-white);
            background: rgba(255, 255, 255, 0.13);
            border: 1px solid rgba(255, 255, 255, 0.24);
            border-radius: 999px;
            font-size: 0.85rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .hero h1 {
            max-width: 730px;
            margin-bottom: 1.35rem;
            font-size: clamp(2.8rem, 7vw, 5.35rem);
            font-weight: 800;
            line-height: 1.02;
            letter-spacing: -0.045em;
        }

        .hero-lead {
            max-width: 680px;
            margin-bottom: 2rem;
            color: rgba(255, 255, 255, 0.92);
            font-size: clamp(1.1rem, 2vw, 1.35rem);
            line-height: 1.65;
        }

        .hero-note {
            margin-top: 1.5rem;
            color: rgba(255, 255, 255, 0.76);
            font-size: 0.94rem;
        }

        /* General sections */

        .section-padding {
            padding-top: 6rem;
            padding-bottom: 6rem;
        }

        .section-label {
            margin-bottom: 0.75rem;
            color: var(--brand-blue);
            font-size: 0.82rem;
            font-weight: 800;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .section-title {
            max-width: 750px;
            margin-right: auto;
            margin-bottom: 1rem;
            margin-left: auto;
            font-size: clamp(2rem, 4vw, 3.1rem);
            font-weight: 800;
            letter-spacing: -0.035em;
        }

        .section-intro {
            max-width: 750px;
            margin-right: auto;
            margin-left: auto;
            color: var(--brand-gray);
            font-size: 1.12rem;
            line-height: 1.75;
        }

        /* Service cards */

        .service-card {
            position: relative;
            height: 100%;
            padding: 2.25rem;
            overflow: hidden;
            background: var(--brand-white);
            border: 1px solid #e7eaee;
            border-radius: 1rem;
            box-shadow: 0 16px 42px rgba(16, 24, 40, 0.07);
            transition:
                transform 0.25s ease,
                box-shadow 0.25s ease;
        }

        .service-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 22px 48px rgba(16, 24, 40, 0.12);
        }

        .service-card.featured {
            border: 2px solid var(--brand-blue);
        }

        .service-card h3 {
            margin-bottom: 1rem;
            font-size: 1.55rem;
            font-weight: 800;
        }

        .service-card p {
            color: var(--brand-gray);
            line-height: 1.75;
        }

        .service-icon {
            display: inline-flex;
            width: 60px;
            height: 60px;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.5rem;
            color: var(--brand-blue);
            background: var(--brand-light-blue);
            border-radius: 0.9rem;
            font-size: 1.65rem;
            font-weight: 800;
        }

        .service-status {
            display: inline-block;
            margin-bottom: 1rem;
            padding: 0.35rem 0.72rem;
            color: #22653f;
            background: #e8f5ec;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 800;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .service-status.developing {
            color: #6c5418;
            background: #fff5d8;
        }

        /* Filter section */

        .filter-section {
            background: var(--brand-light);
        }

        .feature-list {
            padding: 0;
            margin: 0;
            list-style: none;
        }

        .feature-list li {
            position: relative;
            padding-left: 2.1rem;
            margin-bottom: 1rem;
            color: #394150;
            font-size: 1.05rem;
        }

        .feature-list li::before {
            position: absolute;
            top: 0.12rem;
            left: 0;
            width: 1.45rem;
            height: 1.45rem;
            color: var(--brand-white);
            background: var(--brand-green);
            border-radius: 50%;
            content: "✓";
            font-size: 0.85rem;
            font-weight: 900;
            text-align: center;
            line-height: 1.45rem;
        }

        .filter-panel {
            padding: 2.5rem;
            color: var(--brand-white);
            background:
                linear-gradient(
                    145deg,
                    var(--brand-navy),
                    var(--brand-blue)
                );
            border-radius: 1.25rem;
            box-shadow: 0 25px 60px rgba(23, 54, 93, 0.25);
        }

        .filter-panel h3 {
            font-weight: 800;
        }

        .filter-step {
            display: flex;
            gap: 1rem;
            margin-top: 1.5rem;
        }

        .filter-step-number {
            flex: 0 0 42px;
            width: 42px;
            height: 42px;
            color: var(--brand-navy);
            background: var(--brand-white);
            border-radius: 50%;
            font-weight: 900;
            text-align: center;
            line-height: 42px;
        }

        .filter-step h4 {
            margin-bottom: 0.25rem;
            font-size: 1.04rem;
            font-weight: 800;
        }

        .filter-step p {
            margin: 0;
            color: rgba(255, 255, 255, 0.78);
            font-size: 0.93rem;
        }

        /* Trust section */

        .trust-card {
            height: 100%;
            padding: 1.75rem;
            background: var(--brand-white);
            border: 1px solid #e8ebef;
            border-radius: 0.9rem;
        }

        .trust-card h3 {
            font-size: 1.1rem;
            font-weight: 800;
        }

        .trust-card p {
            margin-bottom: 0;
            color: var(--brand-gray);
        }

        /* About */

        .about-box {
            padding: 3rem;
            background: var(--brand-navy);
            border-radius: 1.25rem;
            color: var(--brand-white);
        }

        .about-box p {
            color: rgba(255, 255, 255, 0.82);
            line-height: 1.8;
        }

        /* Contact */

        .contact-section {
            background: var(--brand-light-blue);
        }

        .contact-card {
            padding: 2.75rem;
            background: var(--brand-white);
            border-radius: 1.25rem;
            box-shadow: 0 20px 55px rgba(16, 24, 40, 0.09);
        }

        .contact-link {
            color: var(--brand-navy);
            font-weight: 800;
            text-decoration: none;
        }

        .contact-link:hover {
            color: var(--brand-blue);
        }

        .form-control,
        .form-select {
            min-height: 50px;
            border-color: #d7dce2;
            border-radius: 0.55rem;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--brand-blue);
            box-shadow: 0 0 0 0.2rem rgba(38, 118, 173, 0.15);
        }

        textarea.form-control {
            min-height: 140px;
        }

        /* Footer */

        footer {
            padding-top: 3.5rem;
            padding-bottom: 2rem;
            color: rgba(255, 255, 255, 0.78);
            background: #101a25;
        }

        .footer-logo {
            max-width: 210px;
            padding: 0.75rem;
            background: var(--brand-white);
            border-radius: 0.7rem;
        }

        footer a {
            color: rgba(255, 255, 255, 0.85);
            text-decoration: none;
        }

        footer a:hover {
            color: var(--brand-white);
        }

        /* Owner photo */

        .owner-photo {
            width: 220px;
            height: 220px;
            max-width: 100%;
            object-fit: cover;
            border-radius: 50%;
            border: 6px solid var(--brand-white);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
        }

        /* Tablet and mobile */

        @@media (max-width: 991.98px) {
            .navbar-brand img {
                width: 220px;
                max-width: 100%;
                height: auto;
            }

            .navbar-collapse {
                padding-top: 1rem;
                padding-bottom: 1rem;
            }

            .navbar .nav-link {
                margin-left: 0;
            }

            .hero {
                min-height: 700px;
                padding-top: 100px;
                text-align: center;
                background-position: 62% center;
            }

            .hero-content {
                margin-right: auto;
                margin-left: auto;
                padding-top: 3rem;
                padding-bottom: 4rem;
            }

            .hero-lead {
                margin-right: auto;
                margin-left: auto;
            }
        }

        /* Phones */

        @@media (max-width: 767.98px) {
            .navbar {
                padding: 6px 0;
            }

            .navbar-brand img {
                width: 185px;
                max-width: 75vw;
                height: auto;
            }

            .section-padding {
                padding-top: 4.5rem;
                padding-bottom: 4.5rem;
            }

            .hero {
                min-height: 680px;
                padding-top: 90px;
                background-position: 65% center;
            }

            .hero-content {
                padding-top: 2.5rem;
                padding-bottom: 4rem;
            }

            .service-card,
            .filter-panel,
            .contact-card,
            .about-box {
                padding: 1.75rem;
            }

            .owner-photo {
                width: 180px;
                height: 180px;
            }
        }
    </style>
</head>

<body>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-light fixed-top">
        <div class="container">
            <a class="navbar-brand" href="#home" aria-label="5 Tool Home Care home">
                <img src="/5-tool-logo.svg" alt="5 Tool Home Care">
            </a>

            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNavigation"
                aria-controls="mainNavigation"
                aria-expanded="false"
                aria-label="Toggle navigation"
            >
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavigation">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link" href="#services">Services</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#filter-program">
                            Filter Program
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#about">About</a>
                    </li>

                    <li class="nav-item ms-lg-3">
                        <a class="btn btn-brand" href="#contact">
                            Request Information
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main>

        <!-- Hero -->
        <header class="hero" id="home">
            <div class="container">
                <div class="hero-content">
                    <div class="hero-eyebrow">
                        Local home care in Sunset Beach, NC
                    </div>

                    <h1>Peace of Mind. Fewer To-Do's</h1>

                    <p class="hero-lead">
                        Dependable home-care services designed to give
                        homeowners, retirees, snowbirds, and vacation-property
                        owners one less thing to worry about.
                    </p>

                    <div class="d-flex flex-column flex-sm-row gap-3 justify-content-lg-start justify-content-center">
                        <a class="btn btn-brand btn-lg" href="#filter-program">
                            Explore Filter Maintenance
                        </a>

                        <a class="btn btn-outline-light-custom btn-lg" href="#services">
                            View All Services
                        </a>
                    </div>

                    <p class="hero-note">
                        Filter maintenance is now available in the
                        Sunset Beach area.
                    </p>
                </div>
            </div>
        </header>

        <!-- Service overview -->
        <section class="section-padding" id="services">
            <div class="container">
                <div class="text-center mb-5">
                    <div class="section-label">5 Tool Home Care</div>

                    <h2 class="section-title">
                        We make owning your home easier!
                    </h2>

                    <p class="section-intro">
                        5 Tool Home Care is built around straightforward,
                        dependable services that remove recurring home-maintenance
                        headaches.
                    </p>
                </div>

                <div class="row g-4">

                    <div class="col-lg-4">
                        <article class="service-card featured">
                            <span class="service-status">Available now</span>

                            <div class="service-icon" aria-hidden="true">
                                F
                            </div>

                            <h3>Filter Maintenance</h3>

                            <p>
                                We identify and record your air-filter sizes,
                                track the replacement schedule, supply the
                                correct filters, install them, and dispose of
                                the old ones.
                            </p>

                            <a
                                class="fw-bold text-decoration-none"
                                href="#filter-program"
                            >
                                See how it works →
                            </a>
                        </article>
                    </div>

                    <div class="col-lg-4">
                        <article class="service-card">
                            <span class="service-status developing">
                                Developing service
                            </span>

                            <div class="service-icon" aria-hidden="true">
                                H
                            </div>

                            <h3>Property Management</h3>

                            <p>
                                Local oversight and routine care for vacation
                                properties, including property visits,
                                guest-readiness checks, issue identification,
                                and service coordination.
                            </p>

                            <a
                                class="fw-bold text-decoration-none"
                                href="#contact"
                            >
                                Register your interest →
                            </a>
                        </article>
                    </div>

                    <div class="col-lg-4">
                        <article class="service-card">
                            <span class="service-status developing">
                                Future service
                            </span>

                            <div class="service-icon" aria-hidden="true">
                                P
                            </div>

                            <h3>Pool Care</h3>

                            <p>
                                A planned service line focused on dependable,
                                routine pool attention for homeowners and
                                vacation properties in the local area.
                            </p>

                            <a
                                class="fw-bold text-decoration-none"
                                href="#contact"
                            >
                                Register your interest →
                            </a>
                        </article>
                    </div>

                </div>
            </div>
        </section>

        <!-- Filter program -->
        <section class="section-padding filter-section" id="filter-program">
            <div class="container">
                <div class="row align-items-center g-5">

                    <div class="col-lg-6">
                        <div class="section-label">
                            Featured service
                        </div>

                        <h2 class="display-5 fw-bold mb-4">
                            Never think about your air filter again.
                        </h2>

                        <p class="lead text-secondary mb-4">
                            You should not have to remember the size, search
                            through stores, climb a ladder, or keep track of
                            the next replacement date.
                        </p>

                        <ul class="feature-list">
                            <li>
                                We identify every filter size and location in
                                your home.
                            </li>

                            <li>
                                We create and maintain your replacement record.
                            </li>

                            <li>
                                We track when each filter should be checked or
                                replaced.
                            </li>

                            <li>
                                We supply and install the correct filter.
                            </li>

                            <li>
                                We dispose of the old filter and confirm that
                                service was completed.
                            </li>
                        </ul>

                        <a class="btn btn-brand mt-4" href="#contact">
                            Ask About the Filter Program
                        </a>
                    </div>

                    <div class="col-lg-6">
                        <div class="filter-panel">
                            <p class="text-uppercase fw-bold small opacity-75 mb-2">
                                How it works
                            </p>

                            <h3 class="h2 mb-4">
                                Simple from the first visit forward
                            </h3>

                            <div class="filter-step">
                                <div class="filter-step-number">1</div>
                                <div>
                                    <h4>Initial setup visit</h4>
                                    <p>
                                        We identify your filter sizes,
                                        locations, access needs, and current
                                        replacement schedule.
                                    </p>
                                </div>
                            </div>

                            <div class="filter-step">
                                <div class="filter-step-number">2</div>
                                <div>
                                    <h4>We record the details</h4>
                                    <p>
                                        Your home's filter information is
                                        stored so you no longer have to
                                        remember it.
                                    </p>
                                </div>
                            </div>

                            <div class="filter-step">
                                <div class="filter-step-number">3</div>
                                <div>
                                    <h4>We manage the schedule</h4>
                                    <p>
                                        We keep track of when the filters
                                        should next be inspected or replaced.
                                    </p>
                                </div>
                            </div>

                            <div class="filter-step">
                                <div class="filter-step-number">4</div>
                                <div>
                                    <h4>We complete the replacement</h4>
                                    <p>
                                        The proper filter is supplied,
                                        installed, recorded, and the old filter
                                        is removed.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- Why choose us -->
        <section class="section-padding">
            <div class="container">
                <div class="text-center mb-5">
                    <div class="section-label">Why 5 Tool</div>

                    <h2 class="section-title">
                        Local help. Clear communication. Fewer headaches.
                    </h2>

                    <p class="section-intro">
                        The business is built around doing small but important
                        jobs reliably and making it easier for customers to
                        care for their homes.
                    </p>
                </div>

                <div class="row g-4">
                    <div class="col-md-6 col-lg-3">
                        <div class="trust-card">
                            <h3>Local service</h3>
                            <p>
                                Based in the Sunset Beach area and focused on
                                nearby communities.
                            </p>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <div class="trust-card">
                            <h3>Accurate records</h3>
                            <p>
                                Important home and filter details are recorded
                                rather than left for you to remember.
                            </p>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <div class="trust-card">
                            <h3>Proactive scheduling</h3>
                            <p>
                                Recurring maintenance is tracked so necessary
                                work is less likely to be forgotten.
                            </p>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <div class="trust-card">
                            <h3>Personal accountability</h3>
                            <p>
                                You know who is caring for your home and whom to
                                contact when a question arises.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- About -->
        <section class="section-padding pt-0" id="about">
            <div class="container">
                <div class="about-box">
                    <div class="row align-items-center g-4">
                        <div class="col-lg-4 text-center">

                            <img
                                src="/images/Chris Lugbauer Professional Picture.png"
                                alt="Chris Lugbauer"
                                class="owner-photo mb-4">

                            <div class="section-label text-white opacity-75">
                                Meet the Owner
                            </div>

                            <h2 class="display-6 fw-bold">
                                Chris Lugbauer
                            </h2>

                            <p class="text-white-50">
                                Owner<br>
                                5 Tool Home Care
                            </p>

                        </div>

                        <div class="col-lg-8">
                            <p class="lead mb-3">
                                I created 5 Tool Home Care to help local
                                homeowners eliminate the small but persistent
                                home-care responsibilities that are easy to
                                forget, difficult to perform, or simply not how
                                they want to spend their time.
                            </p>

                            <p class="mb-0">
                                My goal is to provide reliable local service,
                                maintain accurate records, communicate clearly,
                                and treat every customer's home with the same
                                care and attention I give my own.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Contact -->
        <section class="section-padding contact-section" id="contact">
            <div class="container">
                <div class="row g-5 align-items-start">

                    <div class="col-lg-5">
                        <div class="section-label">
                            Contact
                        </div>

                        <h2 class="display-5 fw-bold mb-4">
                            Ladders? Tight Spaces? Remembering Sizes or specs?
                        </h2>

                        <p class="lead text-secondary">
                            Ask about the air-filter program or register your
                            interest in property management or future pool-care
                            services.
                        </p>

