@page
@model FiveToolHomeCare.Pages.Customers.RecordServiceModel
@{
    ViewData["Title"] = "Record Service";
}

<div class="container py-5">

    <h1 class="mb-4">Record Completed Service</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <form method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="row g-3">

            <div class="col-12">
                <label asp-for="CustomerId"
                       class="form-label">Customer</label>
                <select asp-for="CustomerId"
                        asp-items="Model.Customers"
                        class="form-select">
                    <option value="">Select customer...</option>
                </select>
            </div>

            <div class="col-md-6">
                <label asp-for="ServiceDate"
                       class="form-label">Service Date</label>
                <input asp-for="ServiceDate"
                       type="date"
                       class="form-control" />
            </div>

            <div class="col-12">
                <label asp-for="Notes"
                       class="form-label">Service Notes</label>
                <textarea asp-for="Notes"
                          class="form-control"
                          rows="4"></textarea>
            </div>

        </div>

        <button type="submit"
                class="btn btn-primary mt-4">
            Record Service Complete
        </button>

    </form>

</div>